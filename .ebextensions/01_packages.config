---
commands:
  01_download_ffmpeg:
    command: |
      curl -o /tmp/ffmpeg-release-amd64-static.tar.xz \
        https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-amd64-static.tar.xz || \
        (echo "❌ FFmpeg download failed" && exit 1)
  02_extract_ffmpeg:
    command: |
      mkdir -p /tmp/ffmpeg
      tar -xJf /tmp/ffmpeg-release-amd64-static.tar.xz -C /tmp/ffmpeg || \
        (echo "❌ FFmpeg extraction failed" && exit 1)
  03_move_ffmpeg:
    command: |
      mv /tmp/ffmpeg/ffmpeg-*-static/ffmpeg /tmp/ffmpeg/ffmpeg-*-static/ffprobe \
        /usr/local/bin/ || \
        (echo "❌ FFmpeg move failed" && exit 1)
  04_chmod_ffmpeg:
    command: |
      chmod +x /usr/local/bin/ffmpeg /usr/local/bin/ffprobe || \
        (echo "❌ FFmpeg chmod failed" && exit 1)
  05_cleanup:
    command: |
      rm -rf /tmp/ffmpeg /tmp/ffmpeg-release-amd64-static.tar.xz
  06_verify_ffmpeg:
    command: |
      ffmpeg -version > /tmp/ffmpeg_version.log 2>&1 && \
        echo "✅ FFmpeg installed" || echo "⚠️ FFmpeg not functional"