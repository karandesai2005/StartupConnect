commands:
  01_download_ffmpeg:
    command: |
      curl -o /tmp/ffmpeg-release-amd64-static.tar.xz https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-amd64-static.tar.xz || (echo "❌ FFmpeg download failed, proceeding without it" && exit 0)
      tar -C /usr/local/bin -xJf /tmp/ffmpeg-release-amd64-static.tar.xz --strip-components=1 ffmpeg-6.1-amd64-static/ffmpeg || (echo "❌ FFmpeg extraction failed, proceeding without it" && rm -f /tmp/ffmpeg-release-amd64-static.tar.xz && exit 0)
      chmod +x /usr/local/bin/ffmpeg || (echo "❌ FFmpeg chmod failed, proceeding without it" && rm -f /usr/local/bin/ffmpeg && exit 0)
      rm -f /tmp/ffmpeg-release-amd64-static.tar.xz
      ffmpeg -version > /dev/null 2>&1 || echo "⚠️ FFmpeg not functional, some features may be disabled"