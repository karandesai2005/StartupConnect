commands:
  create_uploads_dir:
    command: mkdir -p /var/app/current/Uploads/profile_pictures /var/app/current/Uploads/posts
  set_uploads_permissions:
    command: chmod -R 755 /var/app/current/Uploads
  add_epel_repo:
    command: yum install -y epel-release || echo "EPEL repo already installed or failed"
  install_ffmpeg:
    command: |
      yum install -y ffmpeg ffmpeg-devel || (
        echo "❌ FFmpeg installation failed, trying alternative"
        curl -o /tmp/ffmpeg-release-amd64-static.tar.xz https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-amd64-static.tar.xz || echo "❌ FFmpeg download failed"
        tar -C /usr/bin -xJf /tmp/ffmpeg-release-amd64-static.tar.xz --strip-components=1 ffmpeg-6.1-amd64-static/ffmpeg ffmpeg-6.1-amd64-static/ffprobe || echo "❌ FFmpeg extraction failed"
        chmod +x /usr/bin/ffmpeg /usr/bin/ffprobe || echo "❌ FFmpeg chmod failed"
        rm -f /tmp/ffmpeg-release-amd64-static.tar.xz
      )
      ffmpeg -version > /dev/null 2>&1 && echo "✅ FFmpeg installed" || echo "⚠️ FFmpeg not functional"