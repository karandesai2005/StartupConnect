---
commands:
  create_uploads_dir:
    command: |
      mkdir -p /var/app/current/Uploads/profile_pictures \
        /var/app/current/Uploads/posts
  set_uploads_permissions:
    command: chmod -R 755 /var/app/current/Uploads
  add_epel_repo:
    command: |
      yum install -y epel-release || \
        echo "EPEL repo already installed or failed"
