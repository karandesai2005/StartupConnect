{
  "expo": {
    "name": "PITCH",
    "slug": "StartupConnect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/PITCH.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/PITCH.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.croww.StartupConnect",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/PITCH.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.croww.StartupConnect",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "NOTIFICATIONS"
      ],
      "googleServicesFile": "./google-services.json",
      "colors": {
        "notification_icon_color": "#FF0000"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "8eba90f6-1cae-4a59-9c56-f5f3c265103b"
      }
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/PITCH.png",
          "color": "#ffffff",
          "mode": "production"
        }
      ],
      "./plugins/withFirebaseNotificationColorFix"
    ],
    "owner": "croww"
  }
}