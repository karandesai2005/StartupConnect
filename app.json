{
  "expo": {
    "name": "PITCH",
    "slug": "StartupConnect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/PITCH.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/PITCH.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.croww.StartupConnect"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/PITCH.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.croww.StartupConnect",
      "permissions": [
        "CAMERA",
        "LOCATION",
        "READ_EXTERNAL_STORAGE",
        "INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "8eba90f6-1cae-4a59-9c56-f5f3c265103b"
      }
    },
    "plugins": [
      "expo-font",
      "expo-asset"
    ],
    "owner": "croww"
  }
}
