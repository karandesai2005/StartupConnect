{
  "expo": {
    "name": "PITCH",
    "slug": "StartupConnect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/PITCH1.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/PITCH.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.croww.StartupConnect",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.croww.StartupConnect",
      "versionCode": 3,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "NOTIFICATIONS"
      ],
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/PITCH1.png",
        "backgroundColor": "#ffffff"
      },
      "networkSecurityConfig": {
        "cleartextTrafficPermitted": true,
        "domainRules": [
          {
            "includeSubdomains": true,
            "domains": [
              "pitch-backend-env.eba-ep4nstmn.ap-south-1.elasticbeanstalk.com"
            ]
          }
        ]
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "8eba90f6-1cae-4a59-9c56-f5f3c265103b"
      }
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/PITCH1.png",
          "color": "#ffffff",
          "mode": "production"
        }
      ],
      "./plugins/withFirebaseNotificationColorFix",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "extraPodFileDefinitions": {
              "pod 'GoogleUtilities', :modular_headers => true": null,
              "pod 'FirebaseCoreInternal', :modular_headers => true": null,
              "pod 'FirebaseCore', :modular_headers => true": null,
              "pod 'FirebaseCoreExtension', :modular_headers => true": null,
              "pod 'FirebaseFirestoreInternal', :modular_headers => true": null,
              "pod 'FirebaseFirestore', :modular_headers => true": null
            }
          },
          "android": {
            "extraProguardRules": "-keep class com.facebook.react.** { *; }\n-keep class expo.modules.** { *; }\n-dontwarn com.facebook.react.**"
          }
        }
      ]
    ],
    "owner": "startupconnectteam",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8eba90f6-1cae-4a59-9c56-f5f3c265103b"
    }
  }
}
